generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String       @id @default(uuid()) @db.Uuid
  email                String?      @unique
  passwordHash         String?      @map("password_hash")
  phoneE164            String?      @unique @map("phone_e164")
  displayName          String?      @map("display_name")
  feedingIntervalHours Int?         @map("feeding_interval_hours")
  notificationsEnabled Boolean      @default(true) @map("notifications_enabled")
  lastReminderAt       DateTime?    @map("last_reminder_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  feedingLogs          FeedingLog[]

  @@map("users")
}

model FeedingLog {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  side         Side
  qualityScore Int       @map("quality_score")
  durationMin  Int       @map("duration_min")
  startTime    DateTime  @map("start_time")
  endTime      DateTime? @map("end_time")
  notes        String?
  source       LogSource @default(APP)
  rawMessage   String?   @map("raw_message")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startTime(sort: Desc)], map: "idx_logs_user_starttime_desc")
  @@index([userId, createdAt(sort: Desc)], map: "idx_logs_user_created_desc")
  @@map("feeding_logs")
}

enum Side {
  LEFT
  RIGHT
  BOTH
}

enum LogSource {
  APP
  WHATSAPP
}
