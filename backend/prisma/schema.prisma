// LactaSync database schema
// Designed for low-latency reads of "latest session per user", which drives
// guidance + WhatsApp status command. Hot path indexes are explicit.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Side {
  LEFT
  RIGHT
  BOTH
}

enum LogSource {
  APP
  WHATSAPP
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String?  @unique
  passwordHash String?  @map("password_hash")
  // E.164 phone used to match incoming WhatsApp messages.
  phoneE164    String?  @unique @map("phone_e164")
  displayName  String?  @map("display_name")
  // Per-user guidance interval override (defaults via env).
  feedingIntervalHours Int? @map("feeding_interval_hours")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  feedingLogs  FeedingLog[]

  @@map("users")
}

model FeedingLog {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  side         Side
  // 1-5 quality score, validated at the API layer.
  qualityScore Int       @map("quality_score")
  // Duration in minutes; nullable until session ends (WhatsApp may send finished sessions only).
  durationMin  Int       @map("duration_min")

  startTime    DateTime  @map("start_time")
  endTime      DateTime? @map("end_time")

  notes        String?
  source       LogSource @default(APP)
  // Original free-text from WhatsApp, useful for auditing AI parsing.
  rawMessage   String?   @map("raw_message")

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([userId, startTime(sort: Desc)], name: "idx_logs_user_starttime_desc")
  @@index([userId, createdAt(sort: Desc)], name: "idx_logs_user_created_desc")
  @@map("feeding_logs")
}
