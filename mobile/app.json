{
  "expo": {
    "name": "LactaSync",
    "slug": "lactasync",
    "scheme": "lactasync",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FCE7F3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lactasync.app"
    },
    "android": {
      "package": "com.lactasync.app"
    },
    "plugins": ["expo-router"],
    "extra": {
      "apiBaseUrl": "https://overhung-prelaunch-aflutter.ngrok-free.dev"
    }
  }
}
